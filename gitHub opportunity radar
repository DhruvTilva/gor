<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GOR</title>
  <style>
    :root {
      --bg: #0d1117;
      --panel: #161b22;
      --border: #30363d;
      --text: #c9d1d9;
      --muted: #8b949e;
      --accent: #58a6ff;
      --danger: #f85149;
      --success: #3fb950;
      --space-1: 6px;
      --space-2: 10px;
      --space-3: 16px;
      --space-4: 24px;
      --radius: 8px;
      --font-sm: 0.85rem;
      --font-md: 1rem;
      --font-lg: 1.4rem;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Helvetica", "Arial", sans-serif;
      background: var(--bg);
      color: var(--text);
    }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 24px;
      border-bottom: 1px solid var(--border);
      position: relative;
      gap: 12px;
    }

    .header-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
      min-width: 0;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    header h1 {
      margin: 0 0 var(--space-1) 0;
      font-size: var(--font-lg);
      color: #ffffff;
    }

    header p {
      margin: 0;
      color: var(--muted);
      font-size: var(--font-sm);
    }

    .creator-badge {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 20px;
      padding: 6px 14px;
      white-space: nowrap;
    }

    .creator-label {
      font-size: 0.75rem;
      color: #8b949e;
    }

    .creator-link {
      display: flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      color: #58a6ff;
      font-size: 0.85rem;
      font-weight: 600;
    }

    .creator-link:hover {
      color: #79c0ff;
    }

    .creator-avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid #30363d;
    }

    .guide-btn {
      background: #21262d;
      color: #c9d1d9;
      border: 1px solid #30363d;
      border-radius: 20px;
      padding: 6px 16px;
      font-size: 0.85rem;
      cursor: pointer;
      white-space: nowrap;
    }

    .guide-btn:hover {
      background: #30363d;
      color: #ffffff;
    }

    main {
      padding: var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    section {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: var(--space-3);
    }

    .section-title {
      margin: 0 0 var(--space-2) 0;
      font-size: var(--font-md);
      color: #ffffff;
    }

    .pat-row {
      display: grid;
      grid-template-columns: 1fr auto auto;
      gap: var(--space-2);
      align-items: center;
    }

    label {
      display: block;
      font-size: var(--font-sm);
      margin-bottom: var(--space-1);
      color: var(--muted);
    }

    input[type="password"],
    input[type="text"] {
      width: 100%;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: #0b0f14;
      color: var(--text);
    }

    .btn {
      padding: 10px 14px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: #21262d;
      color: var(--text);
      cursor: pointer;
    }

    .btn:hover { border-color: var(--accent); }

    .status {
      margin-top: var(--space-2);
      font-size: var(--font-sm);
      color: var(--muted);
    }

    .note {
      margin-top: var(--space-2);
      font-size: var(--font-sm);
      color: var(--muted);
    }

    .pill-row {
      display: flex;
      gap: var(--space-2);
      overflow-x: auto;
      padding-bottom: var(--space-1);
    }

    .category-pill {
      white-space: nowrap;
      border-radius: 999px;
      padding: 8px 14px;
      border: 1px solid var(--border);
      background: #0b0f14;
      color: var(--text);
      cursor: pointer;
      font-size: var(--font-sm);
    }

    .category-pill.active {
      border-color: var(--accent);
      color: #ffffff;
      background: #13233a;
    }

    .mode-tabs {
      display: flex;
      gap: var(--space-2);
      margin-top: var(--space-2);
      flex-wrap: wrap;
    }

    .mode-tab {
      border-radius: 6px;
      padding: 8px 12px;
      border: 1px solid var(--border);
      background: #0b0f14;
      color: var(--text);
      cursor: pointer;
      font-size: var(--font-sm);
    }

    .mode-tab.active {
      border-color: var(--accent);
      color: #ffffff;
      background: #13233a;
    }

    .mode-desc {
      color: var(--muted);
      font-size: var(--font-sm);
      margin-top: var(--space-1);
    }

    .search-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: var(--space-2);
      margin-top: var(--space-2);
    }

    .filters-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: var(--space-2);
    }

    .filters-panel {
      margin-top: var(--space-2);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: var(--space-2);
      display: none;
      gap: var(--space-2);
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }

    .filters-panel.open {
      display: grid;
    }

    .filter-group label {
      margin-bottom: 4px;
    }

    select {
      width: 100%;
      padding: 8px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: #0b0f14;
      color: var(--text);
    }

    .checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text);
      font-size: var(--font-sm);
    }

    #controls {
      min-height: 120px;
    }

    #results {
      min-height: 140px;
    }

    .results-meta {
      color: var(--muted);
      font-size: var(--font-sm);
      margin: 0 0 var(--space-2) 0;
    }

    .results-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2);
      flex-wrap: wrap;
    }

    .btn-refresh[disabled] {
      opacity: 0.6;
      cursor: not-allowed;
      border-color: var(--border);
    }

    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: var(--space-3);
    }

    .repo-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .score-badge {
      padding: 4px 10px;
      border-radius: 20px;
      font-weight: bold;
      width: fit-content;
      font-size: var(--font-sm);
    }

    .score-hot { background: #ff4d00; color: #ffffff; }
    .score-good { background: #238636; color: #ffffff; }
    .score-low { background: #6e7681; color: #ffffff; }

    .repo-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2);
    }

    .repo-name {
      color: var(--accent);
      text-decoration: none;
      font-weight: 600;
    }

    .repo-stars {
      color: var(--muted);
      font-size: var(--font-sm);
    }

    .repo-desc {
      margin: 0;
      color: var(--text);
      font-size: var(--font-sm);
    }

    .repo-topics {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .topic {
      background: #0b0f14;
      border: 1px solid var(--border);
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 0.75rem;
      color: var(--muted);
    }

    .why-now {
      background: #0d1117;
      border-left: 3px solid #388bfd;
      padding: 10px;
      border-radius: 4px;
      font-size: 0.85rem;
    }

    .why-now ul {
      margin: 6px 0 0 0;
      padding-left: 16px;
    }

    .recent-pr {
      display: flex;
      flex-direction: column;
      gap: 4px;
      font-size: var(--font-sm);
    }

    .pr-label { color: var(--muted); }
    .pr-title { color: var(--accent); text-decoration: none; }
    .pr-meta { color: var(--muted); }
    .assoc-badge {
      font-size: 0.7rem;
      background: #21262d;
      border: 1px solid #30363d;
      color: #8b949e;
      padding: 2px 6px;
      border-radius: 10px;
      text-transform: lowercase;
    }

    .linkedin-badge {
      background: #0a66c2;
      color: #ffffff;
      font-size: 0.8rem;
      padding: 4px 10px;
      border-radius: 4px;
      width: fit-content;
    }

    .card-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .btn-primary { background: #238636; color: #ffffff; border: none; }
    .btn-secondary { background: #21262d; color: #c9d1d9; border: 1px solid var(--border); }
    .btn-ghost { background: transparent; color: var(--accent); border: 1px solid var(--accent); }

    .loading,
    .error-state,
    .empty-state {
      text-align: center;
      color: var(--muted);
      padding: var(--space-4) 0;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 4px solid var(--border);
      border-top-color: var(--accent);
      margin: 0 auto var(--space-2);
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-3) var(--space-4);
      border-top: 1px solid var(--border);
      color: var(--muted);
      font-size: var(--font-sm);
    }

    #guide-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #0d1117;
      z-index: 1000;
      overflow-y: auto;
      justify-content: center;
    }

    .guide-container {
      max-width: 860px;
      width: 100%;
      padding: 40px 24px;
    }

    .guide-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 40px;
      border-bottom: 1px solid #30363d;
      padding-bottom: 20px;
    }

    .guide-header h1 { margin: 0; font-size: 1.8rem; color: #e6edf3; }
    .guide-header p { margin: 6px 0 0; color: #8b949e; }

    .guide-close {
      background: #21262d;
      border: 1px solid #30363d;
      color: #c9d1d9;
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-size: 0.9rem;
      white-space: nowrap;
    }

    .guide-close:hover { background: #f85149; color: #ffffff; border-color: #f85149; }

    .guide-section {
      margin-bottom: 40px;
      padding-bottom: 32px;
      border-bottom: 1px solid #21262d;
    }

    .guide-section h2 { color: #e6edf3; margin-bottom: 12px; font-size: 1.1rem; }
    .guide-section p { color: #8b949e; line-height: 1.6; margin-bottom: 12px; }

    .guide-steps { display: flex; flex-direction: column; gap: 10px; }

    .guide-step {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      color: #c9d1d9;
      font-size: 0.9rem;
      line-height: 1.5;
    }

    .step-num {
      background: #388bfd;
      color: #ffffff;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: bold;
      flex-shrink: 0;
    }

    .guide-tip {
      background: #161b22;
      border-left: 3px solid #f0883e;
      padding: 12px 16px;
      border-radius: 4px;
      color: #c9d1d9;
      font-size: 0.9rem;
      margin-top: 16px;
    }

    .guide-score-table { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }

    .score-row {
      display: grid;
      grid-template-columns: 2fr 80px 2fr;
      gap: 12px;
      align-items: center;
      background: #161b22;
      border: 1px solid #21262d;
      border-radius: 6px;
      padding: 10px 14px;
      font-size: 0.85rem;
    }

    .score-signal { color: #c9d1d9; }
    .score-points { color: #3fb950; font-weight: bold; text-align: center; }
    .score-why { color: #8b949e; }

    .guide-categories,
    .guide-modes,
    .guide-filters { display: flex; flex-direction: column; gap: 10px; }

    .guide-cat,
    .guide-filter-row {
      background: #161b22;
      border: 1px solid #21262d;
      border-radius: 6px;
      padding: 10px 14px;
      color: #c9d1d9;
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .guide-mode {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      background: #161b22;
      border: 1px solid #21262d;
      border-radius: 6px;
      padding: 12px 14px;
      color: #c9d1d9;
      font-size: 0.88rem;
    }

    .mode-icon { font-size: 1.4rem; flex-shrink: 0; }
    .guide-section a { color: #58a6ff; }

    code {
      background: #21262d;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.85rem;
      color: #f0883e;
    }

    @media (max-width: 600px) {
      header {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
        padding: var(--space-3);
      }
      main { padding: var(--space-3); }
      .pat-row { grid-template-columns: 1fr; }
      footer {
        flex-direction: column;
        gap: 6px;
        align-items: flex-start;
        padding: 12px 24px;
      }
      .cards-grid { grid-template-columns: 1fr; }
      .search-row { grid-template-columns: 1fr; }
      .filters-row { flex-direction: column; align-items: flex-start; gap: var(--space-1); }
      .results-header { flex-direction: column; align-items: flex-start; }
      .score-row { grid-template-columns: 1fr; }
      .guide-header { flex-direction: column; gap: 12px; }
      .header-right { width: 100%; justify-content: flex-start; flex-wrap: wrap; }
    }
  </style>
</head>
<body>
  <header>
    <div class="header-left">
      <h1>🐂 GOR — gitHub opportunity radar</h1>
      <p>Charge at the right repos. At the right time.</p>
    </div>
    <div class="header-right">
      <button class="guide-btn" onclick="openGuide()">📖 User Guide</button>
      <div class="creator-badge">
        <span class="creator-label">Built by</span>
        <a href="https://github.com/DhruvTilva" target="_blank" class="creator-link">
          <img src="https://github.com/DhruvTilva.png" alt="DhruvTilva" class="creator-avatar" />
          <span class="creator-name">@DhruvTilva</span>
        </a>
      </div>
    </div>
  </header>

  <main>
    <section id="pat-section">
      <h2 class="section-title">GitHub Personal Access Token</h2>
      <label for="pat-input">GitHub Personal Access Token</label>
      <div class="pat-row">
        <input id="pat-input" type="password" placeholder="ghp_xxxxxxxxxxxxxxxxxxxx" />
        <button id="save-token" class="btn" type="button">Save Token</button>
        <button id="clear-token" class="btn" type="button">Clear Token</button>
      </div>
      <div id="pat-status" class="status">❌ No token — 60 req/hr limit applies</div>
      <div class="note">
        Token is stored in browser memory only. Never sent to any server. Clears on page close.
        Recommended scope: public_repo read-only.
      </div>
    </section>

    <section id="controls">
      <h2 class="section-title">Controls</h2>
      <div class="pill-row" id="category-row">
        <button class="category-pill" data-category="agents">🤖 Agents</button>
        <button class="category-pill" data-category="rag">🔗 RAG / Vector</button>
        <button class="category-pill" data-category="cookbooks">📒 Cookbooks</button>
        <button class="category-pill" data-category="models">🧠 ML Models</button>
        <button class="category-pill" data-category="mlops">⚙️ MLOps</button>
        <button class="category-pill" data-category="devtools">🛠️ AI Dev Tools</button>
        <button class="category-pill" data-category="data">📊 Data</button>
        <button class="category-pill" data-category="multimodal">🌐 Multimodal</button>
        <button class="category-pill" data-category="research">🔬 Research</button>
      </div>

      <div class="mode-tabs" id="mode-tabs">
        <button class="mode-tab" data-mode="best">🔥 Best Now</button>
        <button class="mode-tab" data-mode="trending">📈 Trending</button>
        <button class="mode-tab" data-mode="gems">💎 Hidden Gems</button>
      </div>
      <div class="mode-desc" id="mode-desc">Highest opportunity score right now</div>

      <div class="search-row">
        <input id="search-input" type="text" placeholder="Search repos by keyword (optional)" />
        <button id="search-btn" class="btn" type="button">Search</button>
      </div>

      <div class="filters-row">
        <button id="filters-toggle" class="btn" type="button">⚙️ Filters</button>
        <span class="status" id="filters-summary">Filters: default</span>
      </div>

      <div id="filters-panel" class="filters-panel">
        <div class="filter-group">
          <label for="filter-min-stars">Min Stars</label>
          <select id="filter-min-stars">
            <option value="1000">1k+</option>
            <option value="5000">5k+</option>
            <option value="10000">10k+</option>
            <option value="20000">20k+</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filter-first-timer">First-timer PR within</label>
          <select id="filter-first-timer">
            <option value="3">3 days</option>
            <option value="7">7 days</option>
            <option value="14" selected>14 days</option>
            <option value="30">30 days</option>
          </select>
        </div>
        <div class="filter-group">
          <label for="filter-language">Language</label>
          <select id="filter-language">
            <option value="any">Any</option>
            <option value="Python">Python</option>
            <option value="JavaScript">JavaScript</option>
            <option value="TypeScript">TypeScript</option>
          </select>
        </div>
        <div class="filter-group">
          <label>Must have good first issue</label>
          <div class="checkbox-row">
            <input id="filter-good-first" type="checkbox" />
            <span>Required</span>
          </div>
        </div>
        <div class="filter-group">
          <label>Exclude forks</label>
          <div class="checkbox-row">
            <input id="filter-exclude-forks" type="checkbox" checked />
            <span>Enabled</span>
          </div>
        </div>
        <div class="filter-group">
          <label>Org-owned only (LinkedIn boost)</label>
          <div class="checkbox-row">
            <input id="filter-org-only" type="checkbox" />
            <span>Enabled</span>
          </div>
        </div>
      </div>
    </section>

    <section id="results">
      <div>Results will render here.</div>
    </section>
  </main>

  <footer>
    <span id="rate-limit">GitHub API: — requests remaining</span>
    <span>Token stored in memory only · clears on page close</span>
  </footer>

  <div id="guide-overlay">
    <div class="guide-container">

      <div class="guide-header">
        <div>
          <h1>🐂 GOR User Guide</h1>
          <p>How to find the best open-source contribution opportunities</p>
        </div>
        <button onclick="closeGuide()" class="guide-close">✕ Close</button>
      </div>

      <div class="guide-section">
        <h2>🔑 Step 1 — Add Your GitHub Token</h2>
        <p>Without a token you only get <strong>60 API requests/hour</strong> — barely enough for one search. With a token you get <strong>5,000 requests/hour</strong>.</p>
        <div class="guide-steps">
          <div class="guide-step"><span class="step-num">1</span>Go to <a href="https://github.com/settings/tokens" target="_blank">github.com/settings/tokens</a></div>
          <div class="guide-step"><span class="step-num">2</span>Click "Generate new token (classic)"</div>
          <div class="guide-step"><span class="step-num">3</span>Select only <code>public_repo</code> scope (read-only, safe)</div>
          <div class="guide-step"><span class="step-num">4</span>Copy token → paste into GOR → click Save Token</div>
          <div class="guide-step"><span class="step-num">5</span>Token lives in browser memory only. Clears when page closes. Never stored anywhere.</div>
        </div>
      </div>

      <div class="guide-section">
        <h2>🎯 Step 2 — Understand the Opportunity Score</h2>
        <p>Every repo is scored <strong>0–100</strong> based on 7 real signals:</p>
        <div class="guide-score-table">
          <div class="score-row"><span class="score-signal">✅ First-timer PR merged &lt; 7 days</span><span class="score-points">+35 pts</span><span class="score-why">Hottest signal — they just welcomed a newcomer</span></div>
          <div class="score-row"><span class="score-signal">✅ Multiple first-timer PRs in window</span><span class="score-points">+20 pts</span><span class="score-why">Pattern confirmed, not a one-off</span></div>
          <div class="score-row"><span class="score-signal">✅ Open "good first issue" labels</span><span class="score-points">+15 pts</span><span class="score-why">Maintainer is actively inviting contributors</span></div>
          <div class="score-row"><span class="score-signal">✅ Open "help wanted" labels</span><span class="score-points">+10 pts</span><span class="score-why">They need people right now</span></div>
          <div class="score-row"><span class="score-signal">✅ Last commit within 7 days</span><span class="score-points">+10 pts</span><span class="score-why">Repo is alive and active</span></div>
          <div class="score-row"><span class="score-signal">✅ Stars in 1k–20k sweet spot</span><span class="score-points">+5 pts</span><span class="score-why">Visible but not oversaturated</span></div>
          <div class="score-row"><span class="score-signal">🏆 Org-owned repo</span><span class="score-points">+5 pts</span><span class="score-why">Big org name on your LinkedIn contributor list</span></div>
        </div>
        <div class="guide-tip">🔥 Score 80+ = Strike NOW. This window may close in days.</div>
      </div>

      <div class="guide-section">
        <h2>📂 Step 3 — Pick the Right Category</h2>
        <div class="guide-categories">
          <div class="guide-cat"><strong>🤖 Agents</strong> — AutoGen, CrewAI, LangGraph type repos. High activity, frequent PRs.</div>
          <div class="guide-cat"><strong>🔗 RAG / Vector</strong> — LlamaIndex, Chroma, Weaviate. Great for ML engineers.</div>
          <div class="guide-cat"><strong>📒 Cookbooks</strong> — Anthropic, OpenAI, Google cookbook repos. Docs/example PRs merge fast and look great on LinkedIn.</div>
          <div class="guide-cat"><strong>🧠 ML Models</strong> — Transformers, diffusers, timm. Larger repos but high visibility.</div>
          <div class="guide-cat"><strong>⚙️ MLOps</strong> — MLflow, DVC, ZenML. Niche but recruiter-friendly keywords.</div>
          <div class="guide-cat"><strong>🛠️ AI Dev Tools</strong> — CLI tools, IDE assistants. Good for developer-focused profiles.</div>
          <div class="guide-cat"><strong>📊 Data</strong> — Datasets, loaders, preprocessing tools.</div>
          <div class="guide-cat"><strong>🌐 Multimodal</strong> — Vision-language, audio, video AI repos.</div>
          <div class="guide-cat"><strong>🔬 Research</strong> — Paper implementations. Niche audience but very high credibility.</div>
        </div>
      </div>

      <div class="guide-section">
        <h2>⚡ Step 4 — Pick the Right Mode</h2>
        <div class="guide-modes">
          <div class="guide-mode"><span class="mode-icon">🔥</span><div><strong>Best Now</strong> — Repos with highest opportunity score. First-timer PR required. Use this for daily scanning.</div></div>
          <div class="guide-mode"><span class="mode-icon">📈</span><div><strong>Trending</strong> — Repos with activity spike in last 7 days. Community attention = more eyeballs on your PR.</div></div>
          <div class="guide-mode"><span class="mode-icon">💎</span><div><strong>Hidden Gems</strong> — 1k–5k stars. Famous enough for LinkedIn, small enough that your PR stands out. Best for beginners.</div></div>
        </div>
      </div>

      <div class="guide-section">
        <h2>🎛️ Step 5 — Use Filters Smartly</h2>
        <div class="guide-filters">
          <div class="guide-filter-row"><strong>First-timer PR within</strong> → Start with 30 days for more results. Narrow to 7 days when you want the hottest opportunities only.</div>
          <div class="guide-filter-row"><strong>Min Stars</strong> → 1k+ for maximum results. Use 10k+ only when targeting LinkedIn-worthy repos.</div>
          <div class="guide-filter-row"><strong>Must have good first issue</strong> → Turn ON when you want pre-approved contribution areas. Narrows results but higher success rate.</div>
          <div class="guide-filter-row"><strong>Org-owned only</strong> → Turn ON for LinkedIn boost. Filters to microsoft/, google/, anthropic/ type repos only.</div>
          <div class="guide-filter-row"><strong>Language</strong> → Keep "Any" for most results. Set Python for ML-heavy repos.</div>
        </div>
      </div>

      <div class="guide-section">
        <h2>🏆 Step 6 — Reading a Card + Taking Action</h2>
        <div class="guide-steps">
          <div class="guide-step"><span class="step-num">1</span><strong>Check the score</strong> — 80+ means act today. 60–79 means good but not urgent.</div>
          <div class="guide-step"><span class="step-num">2</span><strong>Read "Why Now?"</strong> — This tells you exactly why GOR flagged this repo right now.</div>
          <div class="guide-step"><span class="step-num">3</span><strong>Click "See Merged PR"</strong> — Read what kind of PR they recently accepted. Match that style.</div>
          <div class="guide-step"><span class="step-num">4</span><strong>Click "Browse Issues"</strong> — Find a good first issue and comment "I'd like to work on this" to claim it.</div>
          <div class="guide-step"><span class="step-num">5</span><strong>Submit your PR fast</strong> — The window is open now. Every day you wait, it gets more competitive.</div>
        </div>
        <div class="guide-tip">💡 Pro tip: A merged PR to an org repo (Microsoft, Google, Anthropic) is worth 10x on LinkedIn compared to unknown repos.</div>
      </div>

      <div class="guide-section">
        <h2>⏳ Rate Limit Tips</h2>
        <div class="guide-steps">
          <div class="guide-step"><span class="step-num">1</span>Always use a GitHub PAT — 5000 req/hr vs 60 without.</div>
          <div class="guide-step"><span class="step-num">2</span>Watch the footer — shows requests remaining and reset time.</div>
          <div class="guide-step"><span class="step-num">3</span>When exhausted, the Refresh button shows a countdown timer and auto-enables at reset time.</div>
          <div class="guide-step"><span class="step-num">4</span>Each search uses ~20–40 requests. With token you can run 100+ searches per hour.</div>
        </div>
      </div>

    </div>
  </div>

  <script>
    const STATE = {
      token: null,
      currentCategory: null,
      currentMode: 'best',
      currentKeyword: '',
      results: [],
      rateLimitRemaining: null,
      rateLimitReset: null,
      filters: {
        minStars: 1000,
        firstTimerDays: 14,
        mustHaveGoodFirstIssue: false,
        language: 'any',
        excludeForks: true,
        orgOnly: false
      }
    };

    const CATEGORIES = {
      agents: { label: '🤖 Agents', keywords: 'AI agent autonomous llm' },
      rag: { label: '🔗 RAG / Vector', keywords: 'RAG retrieval vector embeddings' },
      cookbooks: { label: '📒 Cookbooks', keywords: 'cookbook recipes examples AI ML' },
      models: { label: '🧠 ML Models', keywords: 'machine learning model training neural' },
      mlops: { label: '⚙️ MLOps', keywords: 'mlops pipeline experiment tracking' },
      devtools: { label: '🛠️ AI Dev Tools', keywords: 'AI developer tools CLI assistant' },
      data: { label: '📊 Data', keywords: 'dataset data loader preprocessing ML' },
      multimodal: { label: '🌐 Multimodal', keywords: 'multimodal vision language audio AI' },
      research: { label: '🔬 Research', keywords: 'arxiv paper implementation research AI' }
    };

    const GH_BASE = 'https://api.github.com';

    const patInput = document.getElementById('pat-input');
    const saveBtn = document.getElementById('save-token');
    const clearBtn = document.getElementById('clear-token');
    const patStatus = document.getElementById('pat-status');
    const categoryPills = document.querySelectorAll('.category-pill');
    const modeTabs = document.querySelectorAll('.mode-tab');
    const modeDesc = document.getElementById('mode-desc');
    const searchInput = document.getElementById('search-input');
    const searchBtn = document.getElementById('search-btn');
    const filtersToggle = document.getElementById('filters-toggle');
    const filtersPanel = document.getElementById('filters-panel');
    const filtersSummary = document.getElementById('filters-summary');
    const filterMinStars = document.getElementById('filter-min-stars');
    const filterFirstTimer = document.getElementById('filter-first-timer');
    const filterGoodFirst = document.getElementById('filter-good-first');
    const filterLanguage = document.getElementById('filter-language');
    const filterExcludeForks = document.getElementById('filter-exclude-forks');
    const filterOrgOnly = document.getElementById('filter-org-only');
    const rateLimitEl = document.getElementById('rate-limit');
    let refreshTimer = null;

    function setPatStatus(text, color) {
      patStatus.textContent = text;
      patStatus.style.color = color;
    }

    function openGuide() {
      document.getElementById('guide-overlay').style.display = 'flex';
    }

    function closeGuide() {
      document.getElementById('guide-overlay').style.display = 'none';
    }

    function updateRateLimitDisplay() {
      if (STATE.rateLimitRemaining === null || STATE.rateLimitRemaining === undefined) return;
      const el = document.getElementById('rate-limit');
      const reset = STATE.rateLimitReset
        ? new Date(STATE.rateLimitReset * 1000).toLocaleTimeString()
        : 'unknown';
      el.textContent = `GitHub API: ${STATE.rateLimitRemaining} requests remaining · resets at ${reset}`;
      el.style.color = parseInt(STATE.rateLimitRemaining, 10) < 10 ? '#f85149' : '#8b949e';
      updateRefreshButtonState();
    }

    function showLoading(show) {
      const container = document.getElementById('results');
      if (!show) return;
      container.innerHTML = `
        <div class="loading">
          <div class="spinner"></div>
          <p>Scanning repos and scoring opportunities...</p>
        </div>`;
    }

    function showError(msg) {
      const container = document.getElementById('results');
      container.innerHTML = `<div class="error-state">⚠️ ${msg}</div>`;
    }

    function updateRefreshButtonState() {
      const btn = document.getElementById('refresh-btn');
      if (!btn) return;
      const remaining = parseInt(STATE.rateLimitRemaining || '0', 10);

      if (remaining === 0 && STATE.rateLimitReset) {
        const now = Math.floor(Date.now() / 1000);
        const seconds = Math.max(0, STATE.rateLimitReset - now);
        const mm = String(Math.floor(seconds / 60)).padStart(2, '0');
        const ss = String(seconds % 60).padStart(2, '0');
        btn.textContent = `⏳ Refresh in ${mm}:${ss}`;
        btn.disabled = true;
      } else {
        btn.textContent = '🔄 Refresh Results';
        btn.disabled = false;
      }

      if (refreshTimer) clearInterval(refreshTimer);
      if (remaining === 0 && STATE.rateLimitReset) {
        refreshTimer = setInterval(() => {
          updateRefreshButtonState();
        }, 1000);
      }
    }

    async function ghFetch(path) {
      const headers = { 'Accept': 'application/vnd.github+json' };
      if (STATE.token) headers['Authorization'] = `Bearer ${STATE.token}`;

      const res = await fetch(`${GH_BASE}${path}`, { headers });
      STATE.rateLimitRemaining = res.headers.get('X-RateLimit-Remaining');
      STATE.rateLimitReset = res.headers.get('X-RateLimit-Reset');
      updateRateLimitDisplay();

      if (!res.ok) throw new Error(`GitHub API error: ${res.status}`);
      return res.json();
    }

    function daysAgo(n) {
      const d = new Date();
      d.setDate(d.getDate() - n);
      return d.toISOString().split('T')[0];
    }

    async function searchRepos(keywords) {
      const keywordList = keywords.split(' ');
      const primary = keywordList[0];
      let q = `${primary} in:name,description,topics`;
      q += ` stars:>=${STATE.filters.minStars}`;
      q += ` pushed:>${daysAgo(30)}`;
      if (STATE.filters.excludeForks) q += ' fork:false';
      if (STATE.filters.language !== 'any') q += ` language:${STATE.filters.language}`;
      if (STATE.filters.orgOnly) q += ' user:type:org';

      console.log('[GOR DEBUG] Search query:', q);

      const data = await ghFetch(
        `/search/repositories?q=${encodeURIComponent(q)}&sort=stars&order=desc&per_page=20`
      );
      console.log('[GOR DEBUG] Repos returned from search:', data.items?.length || 0);
      if (data.items) {
        data.items.forEach(r => console.log(`[GOR DEBUG] Repo: ${r.full_name} | Stars: ${r.stargazers_count} | Pushed: ${r.pushed_at}`));
      }
      return data.items || [];
    }

    async function getRecentMergedPRs(owner, repo) {
      const [page1, page2] = await Promise.all([
        ghFetch(`/repos/${owner}/${repo}/pulls?state=closed&sort=updated&direction=desc&per_page=100&page=1`),
        ghFetch(`/repos/${owner}/${repo}/pulls?state=closed&sort=updated&direction=desc&per_page=100&page=2`)
      ]);
      return [...page1, ...page2].filter(pr => pr.merged_at !== null);
    }

    async function findFirstTimerPRs(owner, repo, withinDays) {
      const prs = await getRecentMergedPRs(owner, repo);
      const cutoff = new Date();
      cutoff.setDate(cutoff.getDate() - withinDays);

      console.log('[GOR] firstTimerDays value:', STATE.filters.firstTimerDays);
      console.log('[GOR] cutoff date:', cutoff.toISOString());
      console.log('[GOR] total merged PRs fetched:', prs.length);
      console.log('[GOR] author_associations found:', prs.map(p => p.author_association));

      const result = prs.filter(pr => {
        const mergedDate = new Date(pr.merged_at);
        const isRecent = mergedDate > cutoff;
        const isFirstTimer = ['FIRST_TIME_CONTRIBUTOR', 'NONE', 'FIRST_TIMER'].includes(pr.author_association);
        return isRecent && isFirstTimer;
      });

      console.log('[GOR] non-contributor PRs matched:', result.length);
      return result;
    }

    async function getLabeledIssueCount(owner, repo, label) {
      try {
        const data = await ghFetch(
          `/search/issues?q=repo:${owner}/${repo}+label:"${label}"+state:open&per_page=1`
        );
        return data.total_count || 0;
      } catch {
        return 0;
      }
    }

    function timeAgo(dateStr) {
      const diff = Date.now() - new Date(dateStr);
      const days = Math.floor(diff / 86400000);
      const hours = Math.floor(diff / 3600000);
      if (hours < 24) return `${hours}h ago`;
      return `${days}d ago`;
    }

    function formatStars(n) {
      if (n >= 1000) return (n / 1000).toFixed(1) + 'k';
      return n;
    }

    async function scoreRepo(repo, firstTimerPRs) {
      let score = 0;
      const reasons = [];

      const ultraRecent = firstTimerPRs.filter(pr => {
        const d = new Date(pr.merged_at);
        return (Date.now() - d) < 7 * 86400000;
      });
      if (ultraRecent.length > 0) {
        score += 35;
        reasons.push(`✅ First-time contributor PR merged ${timeAgo(ultraRecent[0].merged_at)}`);
      }

      if (firstTimerPRs.length >= 2) {
        score += 20;
        reasons.push(`✅ ${firstTimerPRs.length} first-timer PRs merged recently — pattern confirmed`);
      }

      const gfiCount = await getLabeledIssueCount(repo.owner.login, repo.name, 'good first issue');
      if (gfiCount > 0) {
        score += 15;
        reasons.push(`✅ ${gfiCount} open "good first issue" labels`);
      }

      const hwCount = await getLabeledIssueCount(repo.owner.login, repo.name, 'help wanted');
      if (hwCount > 0) {
        score += 10;
        reasons.push(`✅ ${hwCount} open "help wanted" issues`);
      }

      const pushedDays = (Date.now() - new Date(repo.pushed_at)) / 86400000;
      if (pushedDays < 7) {
        score += 10;
        reasons.push(`✅ Last commit ${Math.floor(pushedDays)}d ago — actively maintained`);
      }

      if (repo.stargazers_count >= 1000 && repo.stargazers_count <= 20000) {
        score += 5;
        reasons.push(`✅ ${formatStars(repo.stargazers_count)} stars — visible but not oversaturated`);
      }

      if (repo.owner.type === 'Organization') {
        score += 5;
        reasons.push(`🏆 Org-owned (${repo.owner.login}) — strong LinkedIn signal`);
      }

      return { score: Math.min(score, 100), reasons };
    }

    function scoreBadgeClass(score) {
      if (score >= 80) return 'score-hot';
      if (score >= 60) return 'score-good';
      return 'score-low';
    }

    function buildCard(item) {
      const repo = item.repo;
      const reasons = item.reasons || [];
      const firstTimerPRs = item.firstTimerPRs || [];
      const badgeClass = scoreBadgeClass(item.score);

      return `
        <div class="repo-card" data-score="${item.score}">
          <div class="score-badge ${badgeClass}">🔥 ${item.score}/100</div>
          <div class="repo-header">
            <a href="${repo.html_url}" target="_blank" class="repo-name">${repo.full_name}</a>
            <span class="repo-stars">⭐ ${formatStars(repo.stargazers_count)}</span>
          </div>
          <p class="repo-desc">${repo.description || 'No description'}</p>
          <div class="repo-topics">
            ${(repo.topics || []).slice(0, 4).map(t => `<span class="topic">${t}</span>`).join('')}
          </div>
          <div class="why-now">
            <strong>Why now?</strong>
            <ul>
              ${reasons.map(r => `<li>${r}</li>`).join('')}
            </ul>
          </div>
          ${firstTimerPRs.length > 0 ? `
          <div class="recent-pr">
            <span class="pr-label">Recent first-timer PR:</span>
            <a href="${firstTimerPRs[0].html_url}" target="_blank" class="pr-title">
              "${firstTimerPRs[0].title}"
            </a>
            <span class="pr-meta">by @${firstTimerPRs[0].user.login} · <span class="assoc-badge">${firstTimerPRs[0].author_association}</span> · ${timeAgo(firstTimerPRs[0].merged_at)}</span>
          </div>` : ''}
          ${repo.owner.type === 'Organization' && repo.stargazers_count > 10000 ?
            `<div class="linkedin-badge">🏆 LinkedIn-worthy contribution</div>` : ''}
          <div class="card-actions">
            <a href="${repo.html_url}" target="_blank" class="btn btn-primary">View Repo</a>
            <a href="${repo.html_url}/issues?q=is:open+label:good+first+issue" target="_blank" class="btn btn-secondary">Browse Issues</a>
            ${firstTimerPRs.length > 0 ?
              `<a href="${firstTimerPRs[0].html_url}" target="_blank" class="btn btn-ghost">See Merged PR</a>` : ''}
          </div>
        </div>`;
    }

    function renderResults(scored) {
      const container = document.getElementById('results');

      if (scored.length === 0) {
        container.innerHTML = `
          <div class="empty-state">
            <p>No repos found matching your filters.</p>
            <p>Try increasing the first-timer PR window or lowering the star minimum.</p>
          </div>`;
        return;
      }

      container.innerHTML = `
        <div class="results-header">
          <p class="results-meta">${scored.length} repos found · sorted by opportunity score</p>
          <button id="refresh-btn" class="btn btn-refresh" type="button">🔄 Refresh Results</button>
        </div>
        <div class="cards-grid">
          ${scored.map(item => buildCard(item)).join('')}
        </div>`;
      const refreshBtn = document.getElementById('refresh-btn');
      refreshBtn.addEventListener('click', () => {
        fetchAndScoreRepos();
      });
      updateRefreshButtonState();
    }

    async function fetchAndScoreRepos() {
      showLoading(true);

      const keywords = STATE.currentKeyword ||
        (STATE.currentCategory ? CATEGORIES[STATE.currentCategory].keywords : 'AI machine learning');

      console.log('[GOR DEBUG] Category:', STATE.currentCategory);
      console.log('[GOR DEBUG] Keywords:', keywords);
      console.log('[GOR DEBUG] Mode:', STATE.currentMode);
      console.log('[GOR DEBUG] Filters:', JSON.stringify(STATE.filters));

      try {
        let repos = await searchRepos(keywords);

        if (STATE.currentMode === 'gems') {
          repos = repos.filter(r => r.stargazers_count <= 5000);
        }
        if (STATE.currentMode === 'trending') {
          repos = repos.filter(r => {
            const updated = (Date.now() - new Date(r.updated_at)) / 86400000;
            return updated < 7;
          });
        }

        const scored = [];
        for (const repo of repos) {
          if (repo.archived) continue;

          try {
            const firstTimerPRs = await findFirstTimerPRs(
              repo.owner.login, repo.name, STATE.filters.firstTimerDays
            );
            console.log(`[GOR] ${repo.full_name} 6 ${firstTimerPRs.length} non-contributor PRs found`);

            if (STATE.filters.mustHaveGoodFirstIssue) {
              const gfi = await getLabeledIssueCount(repo.owner.login, repo.name, 'good first issue');
              if (gfi === 0) continue;
            }

            const { score, reasons } = await scoreRepo(repo, firstTimerPRs);
            scored.push({ repo, score, reasons, firstTimerPRs });
          } catch (e) {
            console.warn(`Skipped ${repo.full_name}:`, e.message);
            continue;
          }
        }

        scored.sort((a, b) => b.score - a.score);
        STATE.results = scored;
        renderResults(scored);
        return scored;
      } catch (e) {
        showError(e.message);
        return [];
      } finally {
        showLoading(false);
      }
    }

    function clearActivePills() {
      categoryPills.forEach(pill => pill.classList.remove('active'));
    }

    function setActivePill(pill) {
      clearActivePills();
      pill.classList.add('active');
    }

    function clearActiveTabs() {
      modeTabs.forEach(tab => tab.classList.remove('active'));
    }

    function setActiveTab(tab) {
      clearActiveTabs();
      tab.classList.add('active');
      const mode = tab.dataset.mode;
      if (mode === 'best') modeDesc.textContent = 'Highest opportunity score right now';
      if (mode === 'trending') modeDesc.textContent = 'Spiking in activity this week';
      if (mode === 'gems') modeDesc.textContent = '1k–5k stars, high merge rate, low noise';
    }

    function updateFiltersSummary() {
      const parts = [
        `${Math.floor(STATE.filters.minStars / 1000)}k+ stars`,
        `${STATE.filters.firstTimerDays}d first-timer window`,
        STATE.filters.language === 'any' ? 'any language' : STATE.filters.language,
        STATE.filters.excludeForks ? 'no forks' : 'forks ok'
      ];
      if (STATE.filters.mustHaveGoodFirstIssue) parts.push('good first issue');
      if (STATE.filters.orgOnly) parts.push('org-only');
      filtersSummary.textContent = `Filters: ${parts.join(' · ')}`;
    }

    saveBtn.addEventListener('click', () => {
      const token = patInput.value.trim();
      if (!token) {
        setPatStatus('❌ No token — 60 req/hr limit applies', 'var(--danger)');
        return;
      }
      window.GH_TOKEN = token;
      STATE.token = token;
      patInput.value = '';
      setPatStatus('🔒 Token saved (memory only)', 'var(--success)');
    });

    clearBtn.addEventListener('click', () => {
      window.GH_TOKEN = null;
      STATE.token = null;
      patInput.value = '';
      setPatStatus('❌ No token — 60 req/hr limit applies', 'var(--danger)');
    });

    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        STATE.currentCategory = pill.dataset.category;
        STATE.currentKeyword = '';
        searchInput.value = '';
        setActivePill(pill);
        fetchAndScoreRepos();
      });
    });

    modeTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        STATE.currentMode = tab.dataset.mode;
        setActiveTab(tab);
        fetchAndScoreRepos();
      });
    });

    searchBtn.addEventListener('click', () => {
      STATE.currentKeyword = searchInput.value.trim();
      STATE.currentCategory = null;
      clearActivePills();
      fetchAndScoreRepos();
    });

    searchInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') searchBtn.click();
    });

    filtersToggle.addEventListener('click', () => {
      filtersPanel.classList.toggle('open');
    });

    filterMinStars.addEventListener('change', e => {
      STATE.filters.minStars = parseInt(e.target.value, 10);
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    filterFirstTimer.addEventListener('change', e => {
      STATE.filters.firstTimerDays = parseInt(e.target.value, 10);
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    filterLanguage.addEventListener('change', e => {
      STATE.filters.language = e.target.value;
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    filterGoodFirst.addEventListener('change', e => {
      STATE.filters.mustHaveGoodFirstIssue = e.target.checked;
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    filterExcludeForks.addEventListener('change', e => {
      STATE.filters.excludeForks = e.target.checked;
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    filterOrgOnly.addEventListener('change', e => {
      STATE.filters.orgOnly = e.target.checked;
      updateFiltersSummary();
      fetchAndScoreRepos();
    });

    updateFiltersSummary();
    setActiveTab(document.querySelector('[data-mode="best"]'));
    window.addEventListener('load', () => {
      const defaultPill = document.querySelector('[data-category="agents"]');
      STATE.currentCategory = 'agents';
      STATE.currentMode = 'best';
      setActivePill(defaultPill);
      setActiveTab(document.querySelector('[data-mode="best"]'));
      fetchAndScoreRepos();
    });
  </script>
</body>
</html>
